{
  "name": "moneydangminh",
  "version": "8.5.0",
  "private": true,
  "description": "Heo Xinh — saving, personal finance, and casual games built with Next.js and MariaDB.",
  "scripts": {
    "dev": "next dev",
    "dev:fresh": "npm run db:generate && next dev",
    "clean:diagnostics": "rimraf --impl=native --max-retries=50 --retry-delay=100 .next/diagnostics",
    "clean:build": "node scripts/clean-next-build.mjs",
    "clean": "rimraf --impl=native --max-retries=50 --retry-delay=100 .next",
    "prebuild": "npm run clean:build && npm run db:generate",
    "build": "next build",
    "start": "next start",
    "deploy": "npm run db:deploy && npm run build",
    "prod": "npm run deploy && npm run start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run format:check",
    "test:caro": "tsx scripts/verify-caro-rules.ts",
    "test:game-backend": "node --conditions=react-server --import tsx scripts/verify-game-backend.ts",
    "test:income-plan": "tsx scripts/verify-income-plan.ts",
    "db:generate": "node scripts/prisma-generate.mjs",
    "db:migrate": "prisma migrate dev && npm run db:generate",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed-admin": "npm run db:generate && tsx scripts/seed-admin.ts",
    "postinstall": "npm run db:generate"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "mariadb": "^3.5.3",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "prettier": "^3.9.6",
    "prisma": "^7.9.1",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3"
  }
}
