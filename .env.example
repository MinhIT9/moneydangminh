# Public address used in canonical URLs, sitemap, and social sharing metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MariaDB: keep these values server-only. Never prefix them with NEXT_PUBLIC_.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=finances
DB_USER=replace_with_runtime_user
DB_PASSWORD=replace_with_strong_password

# Required by Prisma migration commands. URL-encode special characters in password.
DATABASE_URL=mysql://replace_with_runtime_user:replace_with_url_encoded_password@127.0.0.1:3306/finances

# At least 32 random characters. Used to hash server sessions.
SESSION_SECRET=replace_with_a_long_random_secret

# Optional one-time administrator bootstrap. Fill these before `npm run db:seed-admin`, then remove
# ADMIN_PASSWORD from your real .env after the account has been created.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PHONE=
ADMIN_DISPLAY_NAME=Quản trị viên

SUPPORT_EMAIL=hotro@example.com
