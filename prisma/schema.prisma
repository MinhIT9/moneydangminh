generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum PaymentMethodType {
  CASH
  BANK
  EWALLET
  CARD
  OTHER
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum IncomeForecastMethod {
  CURRENT_PACE
  THREE_MONTH_AVERAGE
  MANUAL
}

enum DebtDirection {
  I_OWE
  OWED_TO_ME
}

enum DebtStatus {
  ACTIVE
  SETTLED
}

enum GamePresence {
  ONLINE
  MATCHMAKING
  IN_ROOM
  PLAYING
  AWAY
  OFFLINE
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

enum CaroRoomStatus {
  WAITING
  READY
  PLAYING
  FINISHED
  CLOSED
}

enum CaroMatchMode {
  RANKED
  FRIENDLY
}

enum CaroMatchStatus {
  ACTIVE
  X_WON
  O_WON
  DRAW
  CANCELLED
}

enum CaroMark {
  X
  O
}

enum CaroResultReason {
  FIVE_IN_ROW
  SURRENDER
  TIMEOUT
  AGREED_DRAW
  BOARD_FULL
  CANCELLED
}

enum GameMessageScope {
  DIRECT
  ROOM
  MATCH
}

enum GameMessageKind {
  TEXT
  QUICK
  SYSTEM
}

enum GameInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

enum GameNotificationType {
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  NEW_MESSAGE
  ROOM_INVITE
  ROOM_JOINED
  HEARTS_FULL
  RANK_UP
  ACHIEVEMENT
}

model User {
  id              String     @id @default(cuid()) @db.VarChar(30)
  email           String     @unique @db.VarChar(191)
  phone           String     @unique @db.VarChar(30)
  displayName     String     @default("") @db.VarChar(100)
  passwordHash    String     @db.VarChar(255)
  role            UserRole   @default(USER)
  status          UserStatus @default(ACTIVE)
  isLocked        Boolean    @default(false) @map("is_locked")
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  sessions               Session[]
  categories             Category[]
  paymentMethods         PaymentMethod[]
  transactions           Transaction[]
  debts                  Debt[]
  debtPayments           DebtPayment[]
  incomePlans            IncomePlan[]
  gameProfile            GameProfile?
  hostedCaroRooms        CaroRoom[]         @relation("CaroRoomHost")
  joinedCaroRooms        CaroRoom[]         @relation("CaroRoomGuest")
  caroMatchesAsX         CaroMatch[]        @relation("CaroMatchPlayerX")
  caroMatchesAsO         CaroMatch[]        @relation("CaroMatchPlayerO")
  wonCaroMatches         CaroMatch[]        @relation("CaroMatchWinner")
  caroMoves              CaroMove[]
  sentFriendRequests     GameFriendship[]   @relation("FriendRequester")
  receivedFriendRequests GameFriendship[]   @relation("FriendAddressee")
  blockedFriendships     GameFriendship[]   @relation("FriendBlocker")
  sentGameMessages       GameMessage[]      @relation("GameMessageSender")
  receivedGameMessages   GameMessage[]      @relation("GameMessageRecipient")
  sentGameInvites        GameInvite[]       @relation("GameInviteSender")
  receivedGameInvites    GameInvite[]       @relation("GameInviteRecipient")
  gameNotifications      GameNotification[]
  matchmakingEntry       MatchmakingEntry?

  @@map("users")
}

model Session {
  id         String    @id @default(cuid()) @db.VarChar(30)
  userId     String    @map("user_id") @db.VarChar(30)
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastSeenAt DateTime? @map("last_seen_at")
  userAgent  String?   @map("user_agent") @db.VarChar(512)
  ipAddress  String?   @map("ip_address") @db.VarChar(45)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
}

model AppSetting {
  key       String   @id @db.VarChar(100)
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

model Category {
  id         String       @id @default(cuid()) @db.VarChar(30)
  userId     String       @map("user_id") @db.VarChar(30)
  name       String       @db.VarChar(100)
  type       CategoryType
  icon       String?      @db.VarChar(64)
  color      String?      @db.VarChar(16)
  sortOrder  Int          @default(0) @map("sort_order")
  isArchived Boolean      @default(false) @map("is_archived")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, name, type])
  @@index([userId, type, isArchived, sortOrder])
  @@map("categories")
}

model PaymentMethod {
  id         String            @id @default(cuid()) @db.VarChar(30)
  userId     String            @map("user_id") @db.VarChar(30)
  name       String            @db.VarChar(100)
  type       PaymentMethodType @default(CASH)
  icon       String?           @db.VarChar(64)
  color      String?           @db.VarChar(16)
  sortOrder  Int               @default(0) @map("sort_order")
  isArchived Boolean           @default(false) @map("is_archived")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, name])
  @@index([userId, isArchived, sortOrder])
  @@map("payment_methods")
}

model Transaction {
  id               String          @id @default(cuid()) @db.VarChar(30)
  userId           String          @map("user_id") @db.VarChar(30)
  categoryId       String?         @map("category_id") @db.VarChar(30)
  paymentMethodId  String?         @map("payment_method_id") @db.VarChar(30)
  debtId           String?         @map("debt_id") @db.VarChar(30)
  type             TransactionType
  amount           Decimal         @db.Decimal(15, 0)
  amountExpression String?         @map("amount_expression") @db.VarChar(500)
  tipAmount        Decimal         @default(0) @map("tip_amount") @db.Decimal(15, 0)
  tipExpression    String?         @map("tip_expression") @db.VarChar(500)
  note             String?         @db.Text
  occurredOn       DateTime        @map("occurred_on") @db.Date
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  debt          Debt?          @relation("DebtTransactions", fields: [debtId], references: [id], onDelete: SetNull)
  debtPayment   DebtPayment?   @relation("DebtPaymentTransaction")

  @@index([userId, occurredOn])
  @@index([userId, type, occurredOn])
  @@index([userId, categoryId])
  @@index([userId, paymentMethodId])
  @@index([debtId])
  @@map("transactions")
}

model Debt {
  id             String        @id @default(cuid()) @db.VarChar(30)
  userId         String        @map("user_id") @db.VarChar(30)
  counterparty   String        @db.VarChar(150)
  direction      DebtDirection
  originalAmount Decimal       @map("original_amount") @db.Decimal(15, 0)
  status         DebtStatus    @default(ACTIVE)
  note           String?       @db.Text
  startedOn      DateTime      @map("started_on") @db.Date
  dueOn          DateTime?     @map("due_on") @db.Date
  settledOn      DateTime?     @map("settled_on") @db.Date
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[] @relation("DebtTransactions")
  payments     DebtPayment[]

  @@index([userId, status, dueOn])
  @@index([userId, direction, status])
  @@map("debts")
}

model DebtPayment {
  id            String   @id @default(cuid()) @db.VarChar(30)
  userId        String   @map("user_id") @db.VarChar(30)
  debtId        String   @map("debt_id") @db.VarChar(30)
  transactionId String?  @unique @map("transaction_id") @db.VarChar(30)
  amount        Decimal  @db.Decimal(15, 0)
  isSettlement  Boolean  @default(false) @map("is_settlement")
  paidOn        DateTime @map("paid_on") @db.Date
  note          String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  debt        Debt         @relation(fields: [debtId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation("DebtPaymentTransaction", fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([userId, paidOn])
  @@index([debtId, paidOn])
  @@map("debt_payments")
}

model IncomePlan {
  id                       String               @id @default(cuid()) @db.VarChar(30)
  userId                   String               @map("user_id") @db.VarChar(30)
  month                    DateTime             @db.Date
  targetSurplus            Decimal              @default(0) @map("target_surplus") @db.Decimal(15, 0)
  workdaysPerWeek          Int                  @default(6) @map("workdays_per_week")
  extraExpectedExpense     Decimal              @default(0) @map("extra_expected_expense") @db.Decimal(15, 0)
  includeDueDebts          Boolean              @default(true) @map("include_due_debts")
  forecastMethod           IncomeForecastMethod @default(CURRENT_PACE) @map("forecast_method")
  manualMonthlyExpense     Decimal?             @map("manual_monthly_expense") @db.Decimal(15, 0)
  createdAt                DateTime              @default(now()) @map("created_at")
  updatedAt                DateTime              @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
  @@index([userId, month])
  @@map("income_plans")
}

model GameProfile {
  userId                 String       @id @map("user_id") @db.VarChar(30)
  playerCode             String       @unique @map("player_code") @db.VarChar(12)
  avatar                 String       @default("🐷") @db.VarChar(32)
  presence               GamePresence @default(OFFLINE)
  hearts                 Int          @default(5)
  heartRecoveryStartedAt DateTime?    @map("heart_recovery_started_at")
  // Điểm này chỉ thuộc Cờ Caro. Mỗi game mới phải có trường/model xếp hạng riêng.
  caroRating             Int          @default(500) @map("rating")
  caroPeakRating         Int          @default(500) @map("peak_rating")
  rankedWins             Int          @default(0) @map("ranked_wins")
  rankedLosses           Int          @default(0) @map("ranked_losses")
  rankedDraws            Int          @default(0) @map("ranked_draws")
  friendlyWins           Int          @default(0) @map("friendly_wins")
  friendlyLosses         Int          @default(0) @map("friendly_losses")
  friendlyDraws          Int          @default(0) @map("friendly_draws")
  currentWinStreak       Int          @default(0) @map("current_win_streak")
  longestWinStreak       Int          @default(0) @map("longest_win_streak")
  lastSeenAt             DateTime     @default(now()) @map("last_seen_at")
  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([caroRating])
  @@index([presence, lastSeenAt])
  @@map("game_profiles")
}

model GameFriendship {
  id          String           @id @default(cuid()) @db.VarChar(30)
  requesterId String           @map("requester_id") @db.VarChar(30)
  addresseeId String           @map("addressee_id") @db.VarChar(30)
  blockedById String?          @map("blocked_by_id") @db.VarChar(30)
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  requester User  @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User  @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  blockedBy User? @relation("FriendBlocker", fields: [blockedById], references: [id], onDelete: SetNull)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
  @@map("game_friendships")
}

model CaroRoom {
  id          String         @id @default(cuid()) @db.VarChar(30)
  code        String         @unique @db.VarChar(6)
  hostId      String         @map("host_id") @db.VarChar(30)
  guestId     String?        @map("guest_id") @db.VarChar(30)
  status      CaroRoomStatus @default(WAITING)
  hostReady   Boolean        @default(true) @map("host_ready")
  guestReady  Boolean        @default(false) @map("guest_ready")
  turnSeconds Int            @default(45) @map("turn_seconds")
  blockedEnds Boolean        @default(true) @map("blocked_ends")
  expiresAt   DateTime       @map("expires_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  host     User          @relation("CaroRoomHost", fields: [hostId], references: [id], onDelete: Cascade)
  guest    User?         @relation("CaroRoomGuest", fields: [guestId], references: [id], onDelete: SetNull)
  matches  CaroMatch[]
  messages GameMessage[]
  invites  GameInvite[]

  @@index([hostId, status])
  @@index([guestId, status])
  @@index([status, expiresAt])
  @@map("caro_rooms")
}

model CaroMatch {
  id              String            @id @default(cuid()) @db.VarChar(30)
  roomId          String?           @map("room_id") @db.VarChar(30)
  playerXId       String            @map("player_x_id") @db.VarChar(30)
  playerOId       String            @map("player_o_id") @db.VarChar(30)
  winnerId        String?           @map("winner_id") @db.VarChar(30)
  mode            CaroMatchMode
  status          CaroMatchStatus   @default(ACTIVE)
  resultReason    CaroResultReason? @map("result_reason")
  currentTurn     CaroMark          @default(X) @map("current_turn")
  turnStartedAt   DateTime          @default(now()) @map("turn_started_at")
  turnSeconds     Int               @default(45) @map("turn_seconds")
  playerXRating   Int               @map("player_x_rating")
  playerORating   Int               @map("player_o_rating")
  playerXChange   Int?              @map("player_x_change")
  playerOChange   Int?              @map("player_o_change")
  drawOfferedById String?           @map("draw_offered_by_id") @db.VarChar(30)
  drawOfferedAt   DateTime?         @map("draw_offered_at")
  version         Int               @default(0)
  startedAt       DateTime          @default(now()) @map("started_at")
  endedAt         DateTime?         @map("ended_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  room     CaroRoom?     @relation(fields: [roomId], references: [id], onDelete: SetNull)
  playerX  User          @relation("CaroMatchPlayerX", fields: [playerXId], references: [id], onDelete: Cascade)
  playerO  User          @relation("CaroMatchPlayerO", fields: [playerOId], references: [id], onDelete: Cascade)
  winner   User?         @relation("CaroMatchWinner", fields: [winnerId], references: [id], onDelete: SetNull)
  moves    CaroMove[]
  messages GameMessage[]

  @@index([playerXId, status, startedAt])
  @@index([playerOId, status, startedAt])
  @@index([mode, status, startedAt])
  @@index([roomId])
  @@map("caro_matches")
}

model CaroMove {
  id         String   @id @default(cuid()) @db.VarChar(30)
  matchId    String   @map("match_id") @db.VarChar(30)
  playerId   String   @map("player_id") @db.VarChar(30)
  moveNumber Int      @map("move_number")
  mark       CaroMark
  row        Int
  column     Int
  createdAt  DateTime @default(now()) @map("created_at")

  match  CaroMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player User      @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([matchId, moveNumber])
  @@unique([matchId, row, column])
  @@index([playerId, createdAt])
  @@map("caro_moves")
}

model GameMessage {
  id          String           @id @default(cuid()) @db.VarChar(30)
  senderId    String           @map("sender_id") @db.VarChar(30)
  recipientId String?          @map("recipient_id") @db.VarChar(30)
  roomId      String?          @map("room_id") @db.VarChar(30)
  matchId     String?          @map("match_id") @db.VarChar(30)
  scope       GameMessageScope
  kind        GameMessageKind  @default(TEXT)
  content     String           @db.VarChar(500)
  createdAt   DateTime         @default(now()) @map("created_at")

  sender    User       @relation("GameMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User?      @relation("GameMessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  room      CaroRoom?  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  match     CaroMatch? @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt])
  @@index([roomId, createdAt])
  @@index([matchId, createdAt])
  @@index([senderId, createdAt])
  @@map("game_messages")
}

model GameInvite {
  id          String           @id @default(cuid()) @db.VarChar(30)
  senderId    String           @map("sender_id") @db.VarChar(30)
  recipientId String           @map("recipient_id") @db.VarChar(30)
  roomId      String           @map("room_id") @db.VarChar(30)
  status      GameInviteStatus @default(PENDING)
  expiresAt   DateTime         @map("expires_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  sender    User     @relation("GameInviteSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User     @relation("GameInviteRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  room      CaroRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([recipientId, status, expiresAt])
  @@index([roomId, status])
  @@map("game_invites")
}

model GameNotification {
  id        String               @id @default(cuid()) @db.VarChar(30)
  userId    String               @map("user_id") @db.VarChar(30)
  type      GameNotificationType
  title     String               @db.VarChar(160)
  body      String?              @db.VarChar(500)
  href      String?              @db.VarChar(500)
  readAt    DateTime?            @map("read_at")
  createdAt DateTime             @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("game_notifications")
}

model MatchmakingEntry {
  userId     String   @id @map("user_id") @db.VarChar(30)
  caroRating Int      @map("rating")
  enqueuedAt DateTime @default(now()) @map("enqueued_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([caroRating, enqueuedAt])
  @@map("matchmaking_queue")
}
