generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum PaymentMethodType {
  CASH
  BANK
  EWALLET
  CARD
  OTHER
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum DebtDirection {
  I_OWE
  OWED_TO_ME
}

enum DebtStatus {
  ACTIVE
  SETTLED
}

model User {
  id              String     @id @default(cuid()) @db.VarChar(30)
  email           String     @unique @db.VarChar(191)
  phone           String     @unique @db.VarChar(30)
  displayName     String     @default("") @db.VarChar(100)
  passwordHash    String     @db.VarChar(255)
  role            UserRole   @default(USER)
  status          UserStatus @default(ACTIVE)
  isLocked        Boolean    @default(false) @map("is_locked")
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  sessions       Session[]
  categories     Category[]
  paymentMethods PaymentMethod[]
  transactions   Transaction[]
  debts          Debt[]
  debtPayments   DebtPayment[]

  @@map("users")
}

model Session {
  id         String    @id @default(cuid()) @db.VarChar(30)
  userId     String    @map("user_id") @db.VarChar(30)
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastSeenAt DateTime? @map("last_seen_at")
  userAgent  String?   @map("user_agent") @db.VarChar(512)
  ipAddress  String?   @map("ip_address") @db.VarChar(45)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
}

model AppSetting {
  key       String   @id @db.VarChar(100)
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

model Category {
  id         String       @id @default(cuid()) @db.VarChar(30)
  userId     String       @map("user_id") @db.VarChar(30)
  name       String       @db.VarChar(100)
  type       CategoryType
  icon       String?      @db.VarChar(64)
  color      String?      @db.VarChar(16)
  sortOrder  Int          @default(0) @map("sort_order")
  isArchived Boolean      @default(false) @map("is_archived")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, name, type])
  @@index([userId, type, isArchived, sortOrder])
  @@map("categories")
}

model PaymentMethod {
  id         String            @id @default(cuid()) @db.VarChar(30)
  userId     String            @map("user_id") @db.VarChar(30)
  name       String            @db.VarChar(100)
  type       PaymentMethodType @default(CASH)
  icon       String?           @db.VarChar(64)
  color      String?           @db.VarChar(16)
  sortOrder  Int               @default(0) @map("sort_order")
  isArchived Boolean           @default(false) @map("is_archived")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, name])
  @@index([userId, isArchived, sortOrder])
  @@map("payment_methods")
}

model Transaction {
  id              String          @id @default(cuid()) @db.VarChar(30)
  userId          String          @map("user_id") @db.VarChar(30)
  categoryId      String?         @map("category_id") @db.VarChar(30)
  paymentMethodId String?         @map("payment_method_id") @db.VarChar(30)
  debtId          String?         @map("debt_id") @db.VarChar(30)
  type            TransactionType
  amount          Decimal         @db.Decimal(15, 0)
  amountExpression String?        @map("amount_expression") @db.VarChar(500)
  tipAmount       Decimal         @default(0) @map("tip_amount") @db.Decimal(15, 0)
  tipExpression   String?         @map("tip_expression") @db.VarChar(500)
  note            String?         @db.Text
  occurredOn      DateTime        @map("occurred_on") @db.Date
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  debt          Debt?          @relation("DebtTransactions", fields: [debtId], references: [id], onDelete: SetNull)
  debtPayment   DebtPayment?   @relation("DebtPaymentTransaction")

  @@index([userId, occurredOn])
  @@index([userId, type, occurredOn])
  @@index([userId, categoryId])
  @@index([userId, paymentMethodId])
  @@index([debtId])
  @@map("transactions")
}

model Debt {
  id             String        @id @default(cuid()) @db.VarChar(30)
  userId         String        @map("user_id") @db.VarChar(30)
  counterparty   String        @db.VarChar(150)
  direction      DebtDirection
  originalAmount Decimal       @map("original_amount") @db.Decimal(15, 0)
  status         DebtStatus    @default(ACTIVE)
  note           String?       @db.Text
  startedOn      DateTime      @map("started_on") @db.Date
  dueOn          DateTime?     @map("due_on") @db.Date
  settledOn      DateTime?     @map("settled_on") @db.Date
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[] @relation("DebtTransactions")
  payments     DebtPayment[]

  @@index([userId, status, dueOn])
  @@index([userId, direction, status])
  @@map("debts")
}

model DebtPayment {
  id            String   @id @default(cuid()) @db.VarChar(30)
  userId        String   @map("user_id") @db.VarChar(30)
  debtId        String   @map("debt_id") @db.VarChar(30)
  transactionId String?  @unique @map("transaction_id") @db.VarChar(30)
  amount        Decimal  @db.Decimal(15, 0)
  isSettlement  Boolean  @default(false) @map("is_settlement")
  paidOn        DateTime @map("paid_on") @db.Date
  note          String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  debt        Debt         @relation(fields: [debtId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation("DebtPaymentTransaction", fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([userId, paidOn])
  @@index([debtId, paidOn])
  @@map("debt_payments")
}
